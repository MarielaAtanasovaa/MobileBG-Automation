<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{dd-MM-yyyy HH:mm:ss.SSS} [%t] %-5p %logger{36}:%L - %msg%n"/>
        </Console>

        <File name="FileLog" fileName="logs/test.log" append="false" immediateFlush="true">
            <PatternLayout pattern="%d{dd-MM-yyyy HH:mm:ss.SSS} [%t] %-5p %logger{36}:%L - %msg%n"/>
        </File>
    </Appenders>

    <Loggers>
        <Root level="debug">
            <AppenderRef ref="FileLog" level="info"/>
            <AppenderRef ref="FileLog" level="warn"/>
        </Root>
    </Loggers>
</Configuration>